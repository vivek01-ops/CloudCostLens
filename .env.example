# Copy to .env and adjust. Never commit real credentials.

# 1 = allow a no-cloud "demo mode" login button (for local testing).
# 0 = require a real `aws login` / `az login` / existing credentials.
DEMO_MODE=1

# AWS region used for EC2, EBS, EIP and CloudWatch calls (Cost Explorer uses its own endpoint).
AWS_REGION=us-east-1

# Optional: AWS CLI binary name/path if `aws` is not the right name.
# AWS_CLI_BIN=aws

# Optional: Azure CLI binary name/path if `az` is not the right name.
# AZ_CLI_BIN=az

# Optional: AWS profile to log in / read credentials from.
# AWS_PROFILE=default

# Signs the browser session cookie. Set a fixed random value for stable sessions across restarts.
# SECRET_KEY=change-me

# Web server port.
PORT=5000

# Days of cost history to fetch.
COST_DAYS=30
