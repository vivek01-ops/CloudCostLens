# CloudCostLens environment template. Copy to .env and fill in real values.
# NEVER commit a real .env file. The values below are placeholders only.

# Application
APP_NAME=CloudCostLens
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
DEMO_MODE=true

# Database (used by the API, workers, and Alembic)
DATABASE_URL=postgresql+psycopg://ccl:ccl@localhost:5432/cloudcostlens
POSTGRES_USER=ccl
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=cloudcostlens

# Security (generate strong values; do not reuse)
# SECRET_KEY: openssl rand -hex 32
SECRET_KEY=replace-with-a-random-secret
# FERNET_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600

# CORS / frontend
CORS_ORIGINS=http://localhost:3000

# AWS (local development uses the standard credential chain; leave blank to use your profile)
AWS_DEFAULT_REGION=us-east-1
AWS_PRICE_LIST_REGION=us-east-1
DEFAULT_REGIONS=us-east-1,us-west-2,eu-west-1,ap-south-1

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
