# Copy to .env and adjust. Never commit real credentials.

# 1 = allow a no-cloud "demo mode" login button (for local testing).
# 0 = require a real `aws login` / `az login` / existing credentials.
# When DEMO_MODE=0 the app refuses to start unless SECRET_KEY is set.
DEMO_MODE=1

# Signs the browser session cookie. REQUIRED when DEMO_MODE=0.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=change-me

# Send the session cookie only over HTTPS. Defaults to 1 when DEMO_MODE=0,
# otherwise 0. Set to 0 for local HTTP testing behind no TLS terminator.
# COOKIE_SECURE=1

# Enable Flask's debug reloader/stack traces. Keep 0 in production.
# FLASK_DEBUG=0

# Directory for the SQLite store (sessions, rate-limit windows). Mount a volume here.
# DATA_DIR=/app/data

# AWS region used for EC2, EBS, EIP and CloudWatch calls (Cost Explorer uses its own endpoint).
AWS_REGION=us-east-1

# Optional: AWS CLI binary name/path if `aws` is not the right name.
# AWS_CLI_BIN=aws

# Optional: Azure CLI binary name/path if `az` is not the right name.
# AZ_CLI_BIN=az

# Optional: AWS profile to log in / read credentials from.
# AWS_PROFILE=default

# Web server port.
PORT=5000

# Days of cost history to fetch.
COST_DAYS=30
